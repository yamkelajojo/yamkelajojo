# Canonical public origin. Keep this identical to the production Worker URL/custom domain.
SITE_ORIGIN=https://yamkelajojo-portfolio.yamkelajojo.workers.dev

# Portfolio account whose public repositories are displayed.
GITHUB_USERNAME=yamkelajojo

# Optional server-side GitHub token. Configure in production with:
#   npx wrangler secret put GITHUB_TOKEN
# Never expose this as a PUBLIC_ variable.
GITHUB_TOKEN=

# GITHUB_API_BASE_URL is intentionally omitted here; the production service only
# uses api.github.com. The Worker E2E harness overrides it with a loopback stub.
